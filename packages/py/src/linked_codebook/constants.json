{
  "commands": {
    "build": {
      "files": [
        "profile"
      ],
      "summary": "Print a profile as DSV JSON-LD."
    },
    "check-tables": {
      "files": [
        "tables"
      ],
      "summary": "List the sheets and headers of tables that a reader does not use. Prints ok if there are none."
    },
    "conditions": {
      "files": [
        "profile"
      ],
      "summary": "Print the parsed applies_when of every column of a profile that has one, or why it could not be parsed."
    },
    "from-readstat": {
      "files": [
        "variables"
      ],
      "summary": "Print a profile read from the variables of a statistical file (SPSS, Stata, SAS), as JSON from a ReadStat-based reader."
    },
    "from-redcap": {
      "files": [
        "dictionary"
      ],
      "summary": "Print a profile read from a REDCap data dictionary CSV."
    },
    "from-sssom": {
      "files": [
        "sssom",
        "profile"
      ],
      "summary": "Print the mappings in an SSSOM TSV file for the columns and codes of a profile."
    },
    "from-tables": {
      "files": [
        "tables"
      ],
      "summary": "Print a profile read from tables, a JSON object of sheet names and rows (the first row holds the headers)."
    },
    "infer": {
      "files": [
        "data"
      ],
      "summary": "Print a profile with the datatype and level of every column of a JSON object of value lists."
    },
    "merge": {
      "files": [
        "base",
        "incoming"
      ],
      "summary": "Print the first profile completed with the second."
    },
    "missingness": {
      "files": [
        "profile",
        "data"
      ],
      "summary": "Print how the values of each column divide into values, declared missing codes and blanks, and the blanks into skipped by design, missing and unknown, for a JSON object of value lists."
    },
    "normalize": {
      "files": [
        "profile"
      ],
      "summary": "Print a profile, read from profile JSON or DSV JSON-LD, as canonical JSON."
    },
    "parse-condition": {
      "files": [
        "condition"
      ],
      "summary": "Print a condition of skip logic, REDCap branching logic or a SQL WHERE subset, as a JSON tree."
    },
    "to-frictionless": {
      "files": [
        "profile"
      ],
      "summary": "Print the profile as a Frictionless Table Schema, with the other slots in the property x-linked-codebook."
    },
    "to-sssom": {
      "files": [
        "profile"
      ],
      "summary": "Print the mappings of a profile as SSSOM TSV."
    },
    "to-tables": {
      "files": [
        "profile"
      ],
      "summary": "Print the profile as tables, a JSON object of sheet names and rows."
    },
    "validate": {
      "files": [
        "document"
      ],
      "summary": "Check a profile against the model, or DSV JSON-LD against the vocabularies. Exit code 1 if it does not conform."
    }
  },
  "condition": {
    "checkbox": "{name}___{code}",
    "checkbox_other": "[^a-z0-9_]",
    "joins": {
      "&": "and",
      "&&": "and",
      "|": "or",
      "||": "or"
    },
    "operators": {
      "!=": "!=",
      "<": "<",
      "<=": "<=",
      "<>": "!=",
      "=": "==",
      "==": "==",
      ">": ">",
      ">=": ">="
    },
    "tokens": [
      {
        "kind": "space",
        "pattern": "\\s+"
      },
      {
        "kind": "field",
        "pattern": "\\[[^\\]]*\\]"
      },
      {
        "kind": "number",
        "pattern": "-?[0-9]+(?:\\.[0-9]+)?"
      },
      {
        "kind": "string",
        "pattern": "'(?:[^']|'')*'|\"(?:[^\"]|\"\")*\""
      },
      {
        "kind": "join",
        "pattern": "&&|\\|\\||&|\\|"
      },
      {
        "kind": "op",
        "pattern": "<=|>=|<>|!=|==|=|<|>"
      },
      {
        "kind": "punct",
        "pattern": "[(),]"
      },
      {
        "kind": "word",
        "pattern": "[A-Za-z_][A-Za-z0-9_.]*"
      }
    ]
  },
  "enums": {
    "Datatype": {
      "boolean": null,
      "date": null,
      "datetime": null,
      "integer": null,
      "number": null,
      "string": null
    },
    "Level": {
      "categorical": "dsvo:CategoricalDataType",
