  "readstat": {
    "extended_missing": "^\\.[a-z]$",
    "formats": [
      {
        "datatype": "datetime",
        "pattern": "^(?:DATETIME|DTIME|%t[cC])"
      },
      {
        "datatype": "date",
        "pattern": "^(?:DATE|ADATE|EDATE|SDATE|JDATE|QYR|MOYR|WKYR|%t[dD]|%d)"
      },
      {
        "datatype": "integer",
        "pattern": "^(?:F|COMMA|DOT|DOLLAR|N|Z)[0-9]+(?:\\.0)?$"
      },
      {
        "datatype": "integer",
        "pattern": "^%[0-9]+\\.0f$"
      }
    ],
    "integer_types": [
      1,
      2,
      3
    ],
    "labelled_level": "categorical",
    "measure": {
      "1": "nominal",
      "2": "ordinal",
      "3": "numerical"
    },
    "string_type": 0
  },
