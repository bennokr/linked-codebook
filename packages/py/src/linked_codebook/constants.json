        "pattern": "date_.*"
      }
    ]
  },
  "schema": {
    "$defs": {
      "Column": {
        "additionalProperties": false,
        "description": "One column of the table, described as a variable.",
        "properties": {
          "applies_when": {
            "description": "Condition under which the column has a value, as the source writes it, for example REDCap branching logic. Rows that do not meet it are missing by design.",
            "type": "string"
          },
          "closed": {
            "description": "True if values lists every code the column may hold, apart from missing values. A list taken from data is not closed.",
            "type": "boolean"
          },
          "completeness": {
            "description": "Share of the rows that have a value, between 0 and 1.",
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "datatype": {
            "$ref": "#/$defs/Datatype",
            "description": "How values are stored."
          },
          "description": {
            "description": "Definition of the dataset, column or value.",
            "type": "string"
          },
          "format": {
            "description": "How dates, times or numbers are written in the table, for example %d/%m/%Y, in the notation of the source.",
            "type": "string"
          },
          "group": {
            "description": "Name of the group of columns that the column belongs to, for example the form of a REDCap field.",
            "type": "string"
          },
          "identifying": {
            "description": "True if the values identify a person or a record: names, record numbers, contact details. Such a column needs care when the data are shared or synthesized.",
            "type": "boolean"
          },
          "label": {
            "description": "Human-readable name of the column or value.",
            "type": "string"
          },
          "language": {
            "description": "Language of the text in a free-text column, as a lower-case BCP 47 language tag such as nl or en-gb. Set it only for columns of prose.",
            "pattern": "^[a-z]{2,3}(-[a-z0-9]{2,8})*$",
            "type": "string"
          },
          "level": {
            "$ref": "#/$defs/Level",
            "description": "Level of measurement."
          },
          "mappings": {
            "description": "Links to concepts.",
            "items": {
              "$ref": "#/$defs/Mapping"
            },
            "type": "array"
          },
          "maximum": {
            "description": "Largest number the column may hold, apart from missing values.",
            "type": "number"
          },
          "minimum": {
            "description": "Smallest number the column may hold, apart from missing values. A limit of the source, not the smallest number found.",
            "type": "number"
          },
          "missing_range": {
            "$ref": "#/$defs/Range",
            "description": "Numbers that mean no value."
          },
          "missing_values": {
            "description": "Codes that mean no value and have no label.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "name": {
            "description": "Header of the column, exactly as in the table.",
            "type": "string"
          },
          "observed": {
            "description": "Codes found in the data, in order of first occurrence, with their counts. They say what occurred, not what is allowed.",
            "items": {
              "$ref": "#/$defs/Count"
            },
            "type": "array"
          },
          "source": {
            "description": "IRI of a web page that documents the column or its variable.",
            "type": "string"
          },
          "unit": {
            "description": "Unit as text, for example years.",
            "type": "string"
          },
          "unit_iri": {
            "description": "IRI of the unit, for example from QUDT.",
            "type": "string"
          },
          "values": {
            "description": "Codes the column may hold, with their labels. Other codes may occur unless closed is true.",
            "items": {
              "$ref": "#/$defs/Value"
            },
            "type": "array"
          },
          "variable": {
            "description": "IRI of the variable concept the column measures.",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "Column",
        "type": "object"
      },
      "Count": {
        "additionalProperties": false,
        "description": "A code found in the data and how often it occurs.",
        "properties": {
          "code": {
            "description": "The code as stored in the table, as text.",
            "type": "string"
          },
          "count": {
            "description": "How many rows hold the code.",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "code",
          "count"
        ],
        "title": "Count",
        "type": "object"
      },
      "Datatype": {
        "description": "Storage type, named as in CSV on the Web.",
        "enum": [
          "string",
          "number",
          "integer",
          "boolean",
          "date",
          "datetime"
        ],
        "title": "Datatype",
        "type": "string"
