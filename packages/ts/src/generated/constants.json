  "inference": {
    "identifier_names": "id|row.?number|resp?no|.*_id",
    "level": {
      "boolean": "categorical",
      "categorical": "categorical",
      "number": "numerical"
    },
    "limits": {
      "number": 8,
      "text": 50
    },
    "missing": [
      "",
      "\\N"
    ],
    "patterns": {
      "date": "([0-9]{4})-([0-9]{2})-([0-9]{2})(?:[T ](.+))?",
      "dotted_date": "([0-9]{1,2})\\.([0-9]{1,2})\\.([0-9]{4})",
      "leading_zero": "[-+]?0[0-9].*",
      "number": "[-+]?(?:[0-9]+\\.?[0-9]*|\\.[0-9]+)(?:[eE][-+]?[0-9]+)?",
      "time": "([0-9]{2}):([0-9]{2})(?::([0-9]{2})(?:\\.[0-9]{1,9})?)?(?:Z| UTC|[+-][0-9]{2}:[0-9]{2})?"
    },
    "prose": {
      "characters": 80,
      "words": 7
    },
    "sequence_from": 9,
    "small": 8,
    "text_share": 0.1
  },
