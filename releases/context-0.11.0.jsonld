    },
    "columnFormat": "csvw:format",
    "columnGroup": "lc:group",
    "columnProperty": {
      "@id": "dsvo:columnProperty",
      "@type": "@id"
    },
    "columns": {
      "@container": "@set",
      "@id": "dsvo:column"
    },
    "csvw": "http://www.w3.org/ns/csvw#",
    "datasetSchema": {
      "@id": "dsvo:datasetSchema",
      "@type": "@id"
    },
    "datatype": "csvw:datatype",
    "dcat": "http://www.w3.org/ns/dcat#",
    "dct": "http://purl.org/dc/terms/",
    "description": "dct:description",
    "dsvo": "https://w3id.org/dsv-ontology#",
    "exactMatch": {
      "@container": "@set",
      "@id": "skos:exactMatch",
      "@type": "@id"
    },
    "hasCodeBook": {
      "@id": "dsvo:hasCodeBook",
      "@type": "@id"
    },
    "hasUnit": {
      "@id": "qudt:hasUnit",
      "@type": "@id"
    },
    "hasVariable": {
      "@id": "dsvo:hasVariable",
      "@type": "@id"
    },
    "high": "csvw:maxInclusive",
    "identifier": "dct:identifier",
    "identifying": "lc:identifying",
    "landingPage": {
      "@id": "dcat:landingPage",
      "@type": "@id"
    },
    "language": "dct:language",
    "lc": "https://bennokr.github.io/linked-codebook/profile#",
    "license": {
      "@id": "dct:license",
      "@type": "@id"
    },
    "low": "csvw:minInclusive",
    "maximumValue": "csvw:maxInclusive",
    "minimumValue": "csvw:minInclusive",
    "missingRange": "lc:missing_range",
    "name": "csvw:name",
    "narrowMatch": {
      "@container": "@set",
      "@id": "skos:narrowMatch",
      "@type": "@id"
    },
    "nullValues": {
      "@container": "@set",
      "@id": "csvw:null"
    },
    "numberOfColumns": {
      "@id": "dsvo:numberOfColumns",
      "@type": "xsd:integer"
    },
    "numberOfRows": {
      "@id": "dsvo:numberOfRows",
      "@type": "xsd:integer"
    },
    "qudt": "http://qudt.org/schema/qudt/",
    "relatedMatch": {
      "@container": "@set",
      "@id": "skos:relatedMatch",
      "@type": "@id"
    },
    "rights": "dct:rights",
    "schema": "https://schema.org/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "statisticalDataType": {
      "@id": "dsvo:statisticalDataType",
      "@type": "@id"
    },
    "summaryStatistics": {
      "@id": "dsvo:summaryStatistics",
      "@type": "@id"
    },
    "title": "dct:title",
    "titles": "csvw:title",
    "unitText": "schema:unitText",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  }
