{
  "@context": {
    "accessRights": "dct:accessRights",
    "appliesWhen": "lc:applies_when",
    "broadMatch": {
      "@container": "@set",
      "@id": "skos:broadMatch",
      "@type": "@id"
    },
    "citation": "dct:bibliographicCitation",
    "closeMatch": {
      "@container": "@set",
      "@id": "skos:closeMatch",
      "@type": "@id"
    },
    "codeBookClosed": "lc:closed",
    "columnCompleteness": {
